# Google Gemini API Key (obtén una gratis en https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Modelo de Gemini recomendado
GEMINI_MODEL=gemini-3.5-flash-lite

# PIN o contraseña de acceso para proteger tu app al publicarla en internet (opcional)
# Si lo dejas vacío, el acceso es libre; si pones un PIN (ej: 1234), se bloqueará con pantalla de login
AUTH_PIN=

# Puerto interno del servidor
PORT=8000
